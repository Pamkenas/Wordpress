{
  "name": "wordpress-maintenance",
  "version": "0.2.0",
  "description": "Read-only WordPress maintenance inventory collector (Claude Code skill MVP)",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "collect": "node src/index.ts",
    "collect:dry-run": "node src/index.ts --dry-run",
    "collect:sample": "node src/index.ts --sample",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\"",
    "verify": "yarn typecheck && yarn format:check && yarn test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.8"
  }
}
