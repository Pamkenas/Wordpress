# Copy to .env and fill in. Never commit .env.
#
# One application password per site. The variable name is referenced by the
# site's "passwordEnv" field in clients.json. Spaces in WordPress application
# passwords are optional; the collector strips them.
#
# Generate in wp-admin: Users -> (Maintenance Auditor user) -> Application Passwords.

WP_LOCAL_APP_PASSWORD=
WP_ACME_MAIN_APP_PASSWORD=
